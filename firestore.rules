rules_version = '2';

// Regras de segurança da Rota Assombrada (vários condomínios, controle por papéis).
//
// Papéis por condomínio (condominios/{cid}/membros/{uid}.papel):
//   admin    -> edita o condomínio, convites, membros e qualquer casa daquele condomínio
//   morador  -> cadastra e edita só a própria casa (documento com o id da própria conta)
//   pendente -> pediu acesso, aguarda aprovação; não grava casas
// Visitante (sem papel) só lê as casas se o condomínio estiver marcado como público.
// Qualquer pessoa logada com Google pode criar UM condomínio (vira admin dele). O dono da plataforma,
// reconhecido pelo hash SHA-256 do e-mail Google (o e-mail não fica público), cria quantos quiser e é admin de todos.
// Código do condomínio: 5 caracteres sem I, O, 0 e 1 (ex.: K7QPX).
//
// Tudo que não está liberado aqui é negado.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identidade ----------
    function logado() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }
    function eu() { return request.auth.uid; }
    function emailEhDono(e) {
      return e is string && hashing.sha256(e.lower()).toHexString().lower() in [
          'edc3e60dc481e945b137c839efaaf90135694890fc8967d6f013274d3c6a4dee'
        ];
    }
    function donoPlataforma() { return logado() && emailEhDono(request.auth.token.email); }
    // Dono da plataforma e quem criou o condomínio: outros admins não tiram o admin nem removem.
    function protegido(cid, d) {
      return emailEhDono(d.get('email', ''))
        || d.uid == get(/databases/$(database)/documents/condominios/$(cid)).data.get('criadoPor', '');
    }

    // ---------- papéis ----------
    function caminhoMembro(cid) { return /databases/$(database)/documents/condominios/$(cid)/membros/$(request.auth.uid); }
    function papelEh(cid, papeis) {
      return logado() && exists(caminhoMembro(cid)) && get(caminhoMembro(cid)).data.papel in papeis;
    }
    function ehAdmin(cid) { return donoPlataforma() || papelEh(cid, ['admin']); }
    function ehMorador(cid) { return donoPlataforma() || papelEh(cid, ['admin', 'morador']); }
    function condoPublico(cid) {
      return get(/databases/$(database)/documents/condominios/$(cid)).data.publico == true;
    }
    function caminhoCondo(cid) { return /databases/$(database)/documents/condominios/$(cid); }
    // Verdadeiro só na mesma gravação em lote que cria o condomínio, feita por quem o criou.
    function criandoAgora(cid) {
      return logado() && !exists(caminhoCondo(cid)) && existsAfter(caminhoCondo(cid))
        && getAfter(caminhoCondo(cid)).data.criadoPor == eu();
    }
    // Casa atribuída a um e-mail: na casa fica só o SHA-256 de "codigo:email". Quem entra com aquele e-mail pode cuidar dela.
    function meuHash(cid) { return hashing.sha256(cid + ':' + request.auth.token.email.lower()).toHexString().lower(); }
    // Moradores da casa: quem entra com um dos e-mails da lista (guardados só como SHA-256 de "codigo:email").
    // donoHash é o formato antigo, de um e-mail só.
    function responsavel(cid, d) {
      return logado() && (
        (d.get('donoHash', '') != '' && d.donoHash == meuHash(cid))
        || meuHash(cid) in d.get('donoHashes', []));
    }
    // Lista curta (até 6) e cada item no formato certo; regras não têm laço, então confere posição por posição.
    function itensOk(l, re) {
      return l is list && l.size() <= 6
        && (l.size() < 1 || (l[0] is string && l[0].size() <= 160 && l[0].matches(re)))
        && (l.size() < 2 || (l[1] is string && l[1].size() <= 160 && l[1].matches(re)))
        && (l.size() < 3 || (l[2] is string && l[2].size() <= 160 && l[2].matches(re)))
        && (l.size() < 4 || (l[3] is string && l[3].size() <= 160 && l[3].matches(re)))
        && (l.size() < 5 || (l[4] is string && l[4].size() <= 160 && l[4].matches(re)))
        && (l.size() < 6 || (l[5] is string && l[5].size() <= 160 && l[5].matches(re)));
    }
    // Quem pode mexer na casa do evento atual: quem cadastrou ou um morador da lista.
    function caminhoCasaAtual(cid, casaId) {
      return /databases/$(database)/documents/condominios/$(cid)/eventos/$(string(get(/databases/$(database)/documents/condominios/$(cid)).data.get('eventoAtual', 0)))/casas/$(casaId);
    }
    function editorAntes(cid, casaId) {
      let p = caminhoCasaAtual(cid, casaId);
      return logado() && exists(p) && (get(p).data.uid == eu() || responsavel(cid, get(p).data));
    }
    function editorDepois(cid, casaId) {
      let p = caminhoCasaAtual(cid, casaId);
      return logado() && existsAfter(p) && (getAfter(p).data.uid == eu() || responsavel(cid, getAfter(p).data));
    }
    function conviteValido(cid, codigo) {
      let caminho = /databases/$(database)/documents/condominios/$(cid)/convites/$(codigo);
      return codigo is string && exists(caminho)
        && get(caminho).data.ativo == true
        && get(caminho).data.expiraEm > request.time.toMillis();
    }

    // ---------- validação ----------
    function texto(v, max) { return v is string && v.size() <= max; }
    function indiceValido(d) {
      return d.keys().hasOnly(['uid', 'nome', 'mascara', 'atualizadoEm']) && d.keys().hasAll(['uid'])
        && texto(d.uid, 128) && d.uid.size() > 0 && texto(d.get('nome', ''), 60)
        // e-mail só pela metade (ex.: cr•••@gmail.com): o endereço completo nunca vai para o índice
        && texto(d.get('mascara', ''), 80) && (d.get('mascara', '') == '' || d.mascara.matches('^[^@]{1,3}•••@[^@]+$'))
        && (!('atualizadoEm' in d) || d.atualizadoEm is int);
    }
    // Morador de uma casa: hash do e-mail, nome para mostrar e, se quem adicionou digitou, o e-mail.
    function pessoaOk(p) {
      return p is map && p.keys().hasOnly(['h', 'nome', 'email']) && p.keys().hasAll(['h'])
        && p.h is string && p.h.matches('^[0-9a-f]{64}$') && texto(p.get('nome', ''), 60)
        && texto(p.get('email', ''), 160) && (p.get('email', '') == '' || p.email.matches('^[^@\\s]+@[^@\\s]+$'));
    }
    function pessoasOk(l) {
      return l is list && l.size() <= 6
        && (l.size() < 1 || pessoaOk(l[0])) && (l.size() < 2 || pessoaOk(l[1])) && (l.size() < 3 || pessoaOk(l[2]))
        && (l.size() < 4 || pessoaOk(l[3])) && (l.size() < 5 || pessoaOk(l[4])) && (l.size() < 6 || pessoaOk(l[5]));
    }
    function hora(v) { return v is string && (v == '' || v.matches('^[0-2][0-9]:[0-5][0-9]$')); }
    function lista(v, permitidos) { return v is list && v.size() <= permitidos.size() && v.hasOnly(permitidos); }
    function coordenada(p) {
      return p is map && p.keys().hasOnly(['lat', 'lng']) && p.lat is number && p.lng is number
        && p.lat >= -90 && p.lat <= 90 && p.lng >= -180 && p.lng <= 180;
    }

    function condoValido(cid, d) {
      return cid.matches('^[A-HJ-NP-Z2-9]{5}$')
        && d.keys().hasOnly(['nome', 'cidade', 'eventoNome', 'data', 'horaInicio', 'horaFim', 'avisos', 'portaria', 'centro', 'zoom', 'publico', 'listado', 'eventoAtual', 'criadoPor', 'criadoEm', 'atualizadoEm'])
        && (d.get('eventoAtual', 2026) is int && d.get('eventoAtual', 2026) >= 2024 && d.get('eventoAtual', 2026) <= 2099)
        && d.keys().hasAll(['nome', 'centro', 'publico', 'criadoPor'])
        && texto(d.nome, 80) && d.nome.size() > 0
        && texto(d.get('eventoNome', ''), 80)
        && texto(d.get('data', ''), 10)
        && hora(d.get('horaInicio', '')) && hora(d.get('horaFim', ''))
        && texto(d.get('cidade', ''), 60)
        && texto(d.get('avisos', ''), 160)
        && d.get('listado', true) is bool
        && (d.get('portaria', null) == null || coordenada(d.portaria))
        && coordenada(d.centro)
        && d.get('zoom', 17) is int && d.get('zoom', 17) >= 3 && d.get('zoom', 17) <= 20
        && d.publico is bool
        && texto(d.criadoPor, 128);
    }

    function membroValido(mid, d) {
      return d.keys().hasOnly(['uid', 'papel', 'nome', 'email', 'convite', 'criadoEm', 'atualizadoEm'])
        && d.uid == mid
        && d.papel in ['admin', 'morador', 'pendente']
        && texto(d.get('nome', ''), 80)
        && texto(d.get('email', ''), 160)
        && texto(d.get('convite', ''), 40);
    }

    function conviteDocValido(d) {
      return d.keys().hasOnly(['papel', 'ativo', 'expiraEm', 'criadoPor', 'criadoEm'])
        && d.papel == 'morador' && d.ativo is bool && d.expiraEm is number && texto(d.criadoPor, 128);
    }

    function buscaValida(d) {
      return d.keys().hasOnly(['nome', 'cidade', 'prefixos', 'publico', 'atualizadoEm'])
        && texto(d.nome, 80) && d.nome.size() > 0
        && texto(d.get('cidade', ''), 60)
        && d.prefixos is list && d.prefixos.size() <= 120
        && d.publico is bool;
    }

    // Evento de um ano: nome, data, horário e aviso. As casas ficam dentro do evento.
    function eventoValido(ano, d) {
      return ano.matches('^20[2-9][0-9]$')
        && d.keys().hasOnly(['nome', 'data', 'horaInicio', 'horaFim', 'avisos', 'criadoEm', 'atualizadoEm'])
        && texto(d.get('nome', ''), 80)
        && texto(d.get('data', ''), 10)
        && hora(d.get('horaInicio', '')) && hora(d.get('horaFim', ''))
        && texto(d.get('avisos', ''), 160);
    }

    function casaValida(d) {
      return d.keys().hasOnly(['rua', 'numero', 'familia', 'oferece', 'flags', 'horaInicio', 'horaFim', 'obs', 'lat', 'lng', 'uid', 'donoHash', 'donoHashes', 'esgotado', 'criadoEm', 'atualizadoEm'])
        && (!('esgotado' in d) || d.esgotado is bool)
        && (d.get('donoHash', '') == '' || d.get('donoHash', '').matches('^[0-9a-f]{64}$'))
        && itensOk(d.get('donoHashes', []), '^[0-9a-f]{64}$')
        && d.keys().hasAll(['numero', 'lat', 'lng', 'uid'])
        && texto(d.numero, 20) && d.numero.size() > 0
        && texto(d.get('rua', ''), 60)
        && texto(d.get('familia', ''), 60)
        && texto(d.get('obs', ''), 240)
        && lista(d.get('oferece', []), ['doces', 'chocolate', 'brincadeira', 'decoracao', 'lembrancinha'])
        && lista(d.get('flags', []), ['pequenos', 'cachorro', 'alergia', 'assustadora'])
        && hora(d.get('horaInicio', '')) && hora(d.get('horaFim', ''))
        && coordenada({'lat': d.lat, 'lng': d.lng})
        && texto(d.uid, 128)
        && d.get('criadoEm', 0) is number && d.get('atualizadoEm', 0) is number;
    }

    // ---------- "Meus eventos": cada pessoa lista só as próprias participações ----------
    match /{caminho=**}/membros/{mid} {
      allow read: if logado() && resource.data.uid == eu();
    }

    // ---------- busca pública (só nome, cidade e código) ----------
    match /busca/{cid} {
      allow get: if true;
      allow list: if request.query.limit <= 20;
      allow create, update: if buscaValida(request.resource.data) && (ehAdmin(cid) || criandoAgora(cid));
      allow delete: if ehAdmin(cid);
    }

    // ---------- quem já criou um condomínio (limite de um por conta) ----------
    match /criadores/{uid} {
      allow get: if logado() && uid == eu();
      allow create: if logado() && uid == eu()
        && request.resource.data.keys().hasOnly(['cid', 'criadoEm'])
        && request.resource.data.cid is string
        && criandoAgora(request.resource.data.cid);
    }

    // ---------- condomínios ----------
    match /condominios/{cid} {
      // Abrir um condomínio pelo link mostra nome, horário e centro do mapa. Listar todos é só do dono da plataforma.
      allow get: if true;
      allow list: if donoPlataforma();
      // Criar: dono da plataforma à vontade; qualquer outra conta Google só um, registrando em criadores/{uid}
      // na mesma gravação em lote.
      allow create: if logado() && condoValido(cid, request.resource.data)
        && request.resource.data.criadoPor == eu()
        && (donoPlataforma()
            || (!exists(/databases/$(database)/documents/criadores/$(eu()))
                && existsAfter(/databases/$(database)/documents/criadores/$(eu()))
                && getAfter(/databases/$(database)/documents/criadores/$(eu())).data.cid == cid));
      allow update: if ehAdmin(cid) && condoValido(cid, request.resource.data)
        && request.resource.data.criadoPor == resource.data.criadoPor;
      allow delete: if donoPlataforma();

      match /membros/{mid} {
        allow get: if logado() && (mid == eu() || ehAdmin(cid));
        allow list: if ehAdmin(cid);

        // Entrar: com convite válido vira morador; sem convite fica pendente. Admin pode adicionar qualquer papel.
        allow create: if membroValido(mid, request.resource.data) && (
          ehAdmin(cid)
          // quem cria o condomínio entra como admin na mesma gravação
          || (logado() && mid == eu() && request.resource.data.papel == 'admin'
              && request.resource.data.email == request.auth.token.email && criandoAgora(cid))
          || (logado() && mid == eu()
              && exists(/databases/$(database)/documents/condominios/$(cid))
              && request.resource.data.email == request.auth.token.email
              && (request.resource.data.papel == 'pendente'
                  || (request.resource.data.papel == 'morador' && conviteValido(cid, request.resource.data.convite))))
        );
        // Só admin muda papel (aprovar, promover, rebaixar).
        allow update: if ehAdmin(cid) && membroValido(mid, request.resource.data)
          && (donoPlataforma() || mid == eu() || !protegido(cid, resource.data)
              || (request.resource.data.papel == 'admin' && request.resource.data.email == resource.data.email));
        // Admin remove; a própria pessoa pode sair.
        allow delete: if (ehAdmin(cid) && (donoPlataforma() || !protegido(cid, resource.data))) || (logado() && mid == eu());
      }

      match /convites/{codigo} {
        allow read: if ehAdmin(cid);
        allow create, update: if ehAdmin(cid) && codigo.matches('^[A-Za-z0-9]{8,40}$')
          && conviteDocValido(request.resource.data);
        allow delete: if ehAdmin(cid);
      }

      // Casas do formato antigo (antes dos eventos por ano): só leitura para quem já podia ver e
      // limpeza pelo admin depois de passar para o evento do ano. Ninguém cria casa nova aqui.
      match /casas/{casaId} {
        allow read: if ehMorador(cid) || condoPublico(cid);
        allow delete: if ehAdmin(cid);
      }

      // ---------- eventos por ano ----------
      match /eventos/{ano} {
        allow get, list: if true;
        allow create, update: if eventoValido(ano, request.resource.data) && (ehAdmin(cid) || criandoAgora(cid));
        allow delete: if donoPlataforma();

        match /casas/{casaId} {
          allow read: if ehMorador(cid) || condoPublico(cid);
          allow create: if casaValida(request.resource.data) && (
            ehAdmin(cid)
            || (ehMorador(cid) && casaId == eu() && request.resource.data.uid == eu())
          );
          allow update: if casaValida(request.resource.data) && (
            ehAdmin(cid)
            // quem cadastrou e os moradores da lista editam e cuidam da lista de moradores;
            // ninguém troca quem cadastrou, e o formato antigo (donoHash) só pode ser mantido ou apagado
            || ((ehMorador(cid) && resource.data.uid == eu()) || responsavel(cid, resource.data))
                && request.resource.data.uid == resource.data.uid
                && request.resource.data.get('donoHash', '') in [resource.data.get('donoHash', ''), '']
          );
          allow delete: if ehAdmin(cid) || (logado() && resource.data.uid == eu()) || responsavel(cid, resource.data);
        }
      }

      // Diretório de moradores aprovados, pelo SHA-256 de "codigo:email": nome e e-mail pela metade.
      // Moradores buscam aqui para adicionar alguém na casa; pendentes, visitantes e outros condomínios não veem.
      match /emails/{h} {
        allow get, list: if ehMorador(cid);
        allow create, update: if indiceValido(request.resource.data) && (
          ehAdmin(cid)
          || (ehMorador(cid) && h == meuHash(cid) && request.resource.data.uid == eu())
        );
        allow delete: if ehAdmin(cid) || (logado() && h == meuHash(cid));
      }

      // E-mails dos moradores de cada casa: só admins e os próprios moradores daquela casa leem e gravam.
      match /atribuicoes/{casaId} {
        allow read: if ehAdmin(cid) || editorAntes(cid, casaId);
        allow create, update: if (ehAdmin(cid) || editorAntes(cid, casaId) || editorDepois(cid, casaId))
          && request.resource.data.keys().hasOnly(['email', 'emails', 'moradores', 'ano', 'atualizadoEm'])
          && pessoasOk(request.resource.data.get('moradores', []))
          && (!('email' in request.resource.data) || (texto(request.resource.data.email, 160) && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+$')))
          && itensOk(request.resource.data.get('emails', []), '^[^@\\s]+@[^@\\s]+$');
        allow delete: if ehAdmin(cid) || editorAntes(cid, casaId) || editorDepois(cid, casaId);
      }
    }
  }
}
